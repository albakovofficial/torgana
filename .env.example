# Скопируйте этот файл в .env и заполните.

# Порт и адрес сервера
PORT=3000
HOST=0.0.0.0

# Адрес сайта. Если начинается с https:// — cookie входа станут защищёнными (Secure).
PUBLIC_URL=https://torgana.ru

# Email модераторов через запятую; первый — владелец. Эти аккаунты получают доступ к /admin,
# у остальных доступ снимается при перезапуске сайта.
ADMIN_EMAIL=torganaofficial@yandex.ru

# Email поддержки — показывается на страницах «Поддержка», «Безопасность» и в документах.
SUPPORT_EMAIL=support@torgana.ru

# Оператор площадки — подставляется в соглашение, политику и согласие на обработку ПД.
OPERATOR_NAME=ИП Албаков И. М.
OPERATOR_INN=060302809413
OPERATOR_OGRNIP=322060000007916
# Место нахождения (149-ФЗ, ст. 10): для ИП — адрес регистрации или хотя бы город
OPERATOR_ADDRESS=

# Сайт стоит за nginx? Тогда 1 — чтобы правильно определять IP посетителей.
TRUST_PROXY=1

# ИИ-заполнение объявления по фото (необязательно). Без ключа кнопка не показывается.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Где хранить базу и фото (по умолчанию — папки data и uploads рядом с сайтом)
# DATA_DIR=data
# UPLOAD_DIR=uploads
